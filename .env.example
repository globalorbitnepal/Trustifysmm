# ── TrustifySMM environment template ─────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every value below is intentionally blank: real credentials must never appear
# in a tracked file, in Git history, or in a screenshot.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL (webhooks & payment links)
# Production: https://trustifysmm.com   Local dev: http://127.0.0.1:3010
SITE_URL=

# Customer panel sessions (required for sign-in, signup, Google OAuth)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this signs every customer out.
SESSION_SECRET=

# Google OAuth
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${SITE_URL}/api/auth/google/callback when empty
GOOGLE_CALLBACK_URL=

# Orbit admin (/orbit) passkey login
# REQUIRED. Use a strong random value (20+ characters).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Changing this signs the current Orbit session out.
ORBIT_PASSKEY=

# Optional upstream SMM panel
# When set, /api/v2 is proxied instead of served from the local demo store.
SMM_UPSTREAM_API_URL=

# Demo API key (optional; leave empty to keep the demo account unusable)
# There is NO fallback default: with this blank the seeded demo account cannot authenticate.
# Only a SHA-256 hash is stored; never commit or share the real key.
DEMO_API_KEY=

# NOWPayments — crypto deposits (server-side only)
# Dashboard: Settings → Payments → API keys / Instant payment notifications.
# The IPN secret is shown once; regenerating it invalidates the previous one immediately.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Production: https://api.nowpayments.io   Sandbox: https://api-sandbox.nowpayments.io
NOWPAYMENTS_BASE_URL=
NOWPAYMENTS_SANDBOX=
# Limits and expiry default to 5 / 50000 / 60 when left blank.
# A coin can still require more: the live provider minimum is enforced per currency.
NOWPAYMENTS_MIN_DEPOSIT_USD=
NOWPAYMENTS_MAX_DEPOSIT_USD=
NOWPAYMENTS_PAYMENT_EXPIRY_MINUTES=
# Comma-separated provider currency codes. Each network is a separate currency,
# e.g. usdttrc20,usdterc20,usdtbsc,usdc,usdcmatic,btc,eth,ltc,doge,trx,trx
# Only codes the provider reports as enabled will be offered to customers.
BANKER_PAY_CURRENCIES=
# Legacy single-coin alias
BANKER_PAY_CURRENCY=

# PostgreSQL (future panel accounts)
# The wallet, orders and deposit ledger use the JSON store in data/runtime/.
DATABASE_URL=
