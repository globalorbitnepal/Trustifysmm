generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  googleId      String?   @unique
  role          UserRole  @default(CUSTOMER)
  apiKey        String    @unique
  balance       Decimal   @default(0) @db.Decimal(12, 4)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  /// AES-256-GCM ciphertext. Never a plaintext TOTP secret.
  totpSecretEnc       String?
  totpEnabled         Boolean   @default(false)
  totpActivatedAt     DateTime?
  /// Last accepted 30-second step. Rejects a replay of that code.
  totpLastStep        Int?
  totpPendingEnc      String?
  totpPendingExpiresAt DateTime?
  orders        PanelOrder[]
  transactions  WalletTransaction[]
  totpRecoveryCodes TotpRecoveryCode[]
}

/// One-time backup codes. Only the hash is stored.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PanelOrder {
  id         Int      @id @default(autoincrement())
  externalId Int
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service    Int
  link       String
  quantity   Int
  charge     Decimal  @db.Decimal(12, 4)
  status     String
  remains    Int
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([externalId])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 4)
  type      String
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
}