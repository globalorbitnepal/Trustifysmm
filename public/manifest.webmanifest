{
  "name": "TrustifySMM — SMM Panel",
  "short_name": "TrustifySMM",
  "description": "Order social media marketing services, manage your wallet and track orders from the TrustifySMM panel.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#08091b",
  "theme_color": "#08091b",
  "categories": ["business", "productivity"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "New Order",
      "short_name": "Order",
      "url": "/dashboard/new-order"
    },
    {
      "name": "Add Funds",
      "short_name": "Funds",
      "url": "/dashboard/add-funds"
    },
    {
      "name": "My Orders",
      "short_name": "Orders",
      "url": "/dashboard/orders"
    }
  ]
}
